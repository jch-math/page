---
import { withBase } from '@lib/site';

interface Attachment {
  title: string;
  type: string;
  url: string;
  description?: string;
}

const { items = [], title = '附件与资料' }: { items?: Attachment[]; title?: string } = Astro.props;
---

{
  items.length > 0 && (
    <section class="attachment-list" aria-labelledby="attachments-heading">
      <h2 id="attachments-heading">{title}</h2>
      <ul>
        {items.map((item) => (
          <li>
            <a href={withBase(item.url)}>{item.title} <span aria-hidden="true">↗</span></a>
            <span>{item.type}{item.description ? ` · ${item.description}` : ''}</span>
          </li>
        ))}
      </ul>
    </section>
  )
}
