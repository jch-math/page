---
import { formatDate, type ContentIndexItem } from '@lib/site';

interface Props {
  items: ContentIndexItem[];
  emptyMessage?: string;
}

const { items, emptyMessage = '这里还没有内容。' } = Astro.props;
---

{
  items.length > 0 ? (
    <ol class="content-list">
      {items.map((item) => {
        const external = /^https?:\/\//.test(item.href);
        return (
          <li>
            <article class="content-list-item">
              <p class="content-list-meta">
                <time datetime={item.date}>{formatDate(item.date)}</time>
              </p>
              <div class="content-list-main">
                <h2>
                  <a href={item.href} target={external ? '_blank' : undefined} rel={external ? 'noreferrer' : undefined}>
                    {item.title}
                    {external && <span class="visually-hidden">（在新窗口打开）</span>}
                  </a>
                </h2>
                <p>{item.summary}</p>
              </div>
            </article>
          </li>
        );
      })}
    </ol>
  ) : (
    <div class="empty-state">
      <p>{emptyMessage}</p>
    </div>
  )
}
