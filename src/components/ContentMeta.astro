---
import { formatDate, formatDateTime } from '@lib/site';

const { date, updated, time, status, type, location } = Astro.props;
---

<dl class="content-meta">
  {date && <div><dt>Date</dt><dd>{formatDateTime(date, time)}</dd></div>}
  {updated && <div><dt>Updated</dt><dd>{formatDate(updated)}</dd></div>}
  {type && <div><dt>Type</dt><dd>{type}</dd></div>}
  {status && <div><dt>Status</dt><dd>{status}</dd></div>}
  {location && <div><dt>Location</dt><dd>{location}</dd></div>}
</dl>
