---
import { withBase } from '@lib/site';

const { profile } = Astro.props;
const year = new Date().getFullYear();
const copyrightName = profile?.footer?.copyrightName ?? profile?.name ?? 'Self Page';
---

<footer class="site-footer">
  <div>
    <span>© {year} {copyrightName}</span>
    {profile?.footer?.license && <span>{profile.footer.license}</span>}
  </div>
  <nav aria-label="页脚导航">
    <a href={withBase('/rss.xml')}>RSS</a>
    {profile?.links?.github && <a href={profile.links.github}>GitHub</a>}
  </nav>
</footer>
