---
import { withBase } from '@lib/site';

const { profile } = Astro.props;

const navItems = [
  { href: '/posts/', label: '文章' },
  { href: '/projects/', label: '项目' },
  { href: '/links/', label: '链接' },
];
---

<header class="site-header">
  <a class="site-title" href={withBase('/')} aria-label="返回首页">
    <span aria-hidden="true">N.</span>
    <span>{profile?.siteTitle ?? 'Neko'}</span>
  </a>
  <div class="header-actions">
    <nav class="site-nav" aria-label="主导航">
      {
        navItems.map((item) => (
          <a href={withBase(item.href)} aria-current={Astro.url.pathname.includes(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
    <button class="theme-toggle" type="button" data-theme-toggle aria-label="切换明暗主题" title="切换明暗主题">
      <span aria-hidden="true">◐</span>
    </button>
  </div>
</header>
