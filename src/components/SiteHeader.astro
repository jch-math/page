---
import { withBase } from '@lib/site';

const { profile } = Astro.props;

const navItems = [
  { href: '/posts/', label: '文章' },
  { href: '/projects/', label: '项目' },
  { href: '/links/', label: '链接' },
];
---

<header class="site-header">
  <a class="site-title" href={withBase('/')} aria-label="返回首页">
    <span aria-hidden="true">N.</span>
    <span>{profile?.siteTitle ?? 'Neko'}</span>
  </a>
  <div class="header-actions">
    <nav class="site-nav" aria-label="主导航">
      {
        navItems.map((item) => (
          <a href={withBase(item.href)} aria-current={Astro.url.pathname.includes(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
    <button class="theme-toggle" type="button" data-theme-toggle aria-label="切换为深色主题" title="切换为深色主题" aria-pressed="false">
      <svg class="theme-icon theme-icon-light" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="3.5"></circle>
        <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M18.7 5.3l-1.4 1.4M6.7 17.3l-1.4 1.4"></path>
      </svg>
      <svg class="theme-icon theme-icon-dark" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M20 15.4A8.5 8.5 0 0 1 8.6 4a8.5 8.5 0 1 0 11.4 11.4Z"></path>
      </svg>
    </button>
  </div>
</header>
