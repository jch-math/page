---
import { tagHref } from '@lib/site';

const { tags = [], linked = true }: { tags?: string[]; linked?: boolean } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class="tag-list" aria-label="标签">
      {tags.map((tag) => (
        <li>{linked ? <a href={tagHref(tag)}>#{tag}</a> : <span>#{tag}</span>}</li>
      ))}
    </ul>
  )
}
