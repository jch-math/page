---
import { getEntry } from 'astro:content';
import PageTitle from '@components/PageTitle.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { withBase } from '@lib/site';

const profile = (await getEntry('profile', 'site'))?.data;
---

<BaseLayout title="About" description={profile?.bio}>
  <PageTitle title="About" description={profile?.tagline} />
  <div class="about-grid">
    <aside class="profile-box">
      <h2>{profile?.name}</h2>
      {profile?.role && <p>{profile.role}</p>}
      {profile?.affiliation && <p class="muted">{profile.affiliation}</p>}
      {profile?.location && <p class="muted">{profile.location}</p>}
      <div class="links">
        {profile?.links?.github && <a href={profile.links.github}>GitHub</a>}
        {profile?.links?.email && <a href={profile.links.email}>Email</a>}
        {profile?.links?.cv && <a href={withBase(profile.links.cv)}>CV</a>}
        {profile?.links?.googleScholar && <a href={profile.links.googleScholar}>Google Scholar</a>}
        {profile?.links?.orcid && <a href={profile.links.orcid}>ORCID</a>}
      </div>
    </aside>
    <section class="text-stack">
      <h2>Bio</h2>
      <p>{profile?.bio}</p>
      {profile?.interests?.length > 0 && (
        <>
          <h2>Interests</h2>
          <ul class="tag-list" aria-label="Interests">
            {profile.interests.map((interest) => (
              <li><span class="pill">{interest}</span></li>
            ))}
          </ul>
        </>
      )}
    </section>
  </div>
</BaseLayout>
