---
import { getEntry } from 'astro:content';
import TagList from '@components/TagList.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { formatDate, getPublicContent, typeLabel, withBase } from '@lib/site';

const profile = (await getEntry('profile', 'site'))?.data;
const content = await getPublicContent();
const latest = content.slice(0, 4);
const featuredProjects = content.filter((item) => item.type === 'project' && item.featured).slice(0, 2);
const recentLinks = content.filter((item) => item.type === 'link').slice(0, 3);
---

<BaseLayout title={profile?.siteTitle} description={profile?.tagline}>
  <section class="home-intro" aria-labelledby="intro-title">
    <div class="intro-copy">
      <p class="eyebrow">{profile?.role}</p>
      <h1 id="intro-title">你好，我是 <em>{profile?.name ?? 'Neko'}</em>。</h1>
      <p class="lede">{profile?.tagline}</p>
      <p class="intro-bio">{profile?.bio}</p>
      <div class="intro-actions">
        <a class="button-link" href={withBase('/posts/')}>开始阅读</a>
        {profile?.links?.github && <a class="text-link" href={profile.links.github}>在 GitHub 上找到我 <span aria-hidden="true">↗</span></a>}
      </div>
      <ul class="interest-list" aria-label="关注方向">
        {(profile?.interests ?? []).map((interest) => <li>{interest}</li>)}
      </ul>
    </div>

    <aside class="now-note" aria-label="此刻">
      <p class="note-label">此刻 · NOW</p>
      <p>{profile?.currentFocus}</p>
      {profile?.currentFocusUpdated && <span>更新于 {profile.currentFocusUpdated}</span>}
    </aside>
  </section>

  <section class="home-section">
    <div class="section-heading">
      <div>
        <p class="section-index">01</p>
        <h2>最近更新</h2>
      </div>
      <a href={withBase('/posts/')}>查看全部文章</a>
    </div>
    <ol class="update-list">
      {latest.map((item) => {
        const external = /^https?:\/\//.test(item.href);
        return (
          <li>
            <a href={item.href} target={external ? '_blank' : undefined} rel={external ? 'noreferrer' : undefined}>
              <div>
                <span class="meta">{typeLabel(item.type)} · {formatDate(item.date)}</span>
                <h3>{item.title}</h3>
                <p>{item.summary}</p>
              </div>
              <span class="arrow" aria-hidden="true">{external ? '↗' : '→'}</span>
            </a>
          </li>
        );
      })}
    </ol>
  </section>

  <section class="home-section">
    <div class="section-heading">
      <div>
        <p class="section-index">02</p>
        <h2>正在做的项目</h2>
      </div>
      <a href={withBase('/projects/')}>查看全部项目</a>
    </div>
    <div class="feature-grid">
      {featuredProjects.map((project) => (
        <article class="feature-card">
          <p class="meta">精选项目</p>
          <h3><a href={project.href}>{project.title}</a></h3>
          <p>{project.summary}</p>
          <TagList tags={project.tags} />
        </article>
      ))}
      {featuredProjects.length === 0 && <div class="empty-state"><p>项目正在整理中。</p></div>}
    </div>
  </section>

  <section class="home-section">
    <div class="section-heading">
      <div>
        <p class="section-index">03</p>
        <h2>近期收藏</h2>
      </div>
      <a href={withBase('/links/')}>查看全部链接</a>
    </div>
    <ol class="link-strip">
      {recentLinks.map((item) => (
        <li>
          <a href={item.href} target="_blank" rel="noreferrer">
            <span>{item.title}</span>
            <span aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>
