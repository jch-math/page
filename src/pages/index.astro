---
import { getEntry } from 'astro:content';
import ContentList from '@components/ContentList.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { getPublicContent, withBase } from '@lib/site';

const profile = (await getEntry('profile', 'site'))?.data;
const content = await getPublicContent();
const latest = content.slice(0, 3);
---

<BaseLayout title={profile?.siteTitle} description={profile?.tagline}>
  <section class="home-overview" aria-labelledby="intro-title">
    <div class="home-profile">
      <h1 id="intro-title">你好，我是 {profile?.name ?? 'Neko'}。</h1>
      <p>{profile?.tagline} {profile?.bio}</p>
      <a href={withBase('/posts/')}>浏览文章 <span aria-hidden="true">→</span></a>
    </div>

    <div class="home-latest">
      <h2>最近更新</h2>
      <ContentList items={latest} />
    </div>
  </section>
</BaseLayout>
