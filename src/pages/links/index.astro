---
import ContentList from '@components/ContentList.astro';
import PageHeader from '@components/PageHeader.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { loadPublicCatalog } from '@lib/content';

const { links } = await loadPublicCatalog();
const groups = Object.entries(Object.groupBy(links, ({ entry }) => entry.data.category));
---

<BaseLayout title="链接" description="值得反复阅读、使用或分享的链接收藏。">
  <PageHeader
    title="链接"
    description="收藏不是囤积。这里只留下那些值得再次打开，也愿意分享给朋友的东西。"
  />
  <div class="link-groups">
    {groups.map(([category, entries]) => (
      <section>
        <h2>{category}</h2>
        <ContentList items={(entries ?? []).map(({ item }) => item)} />
      </section>
    ))}
    {groups.length === 0 && <div class="empty-state"><p>链接收藏正在整理中。</p></div>}
  </div>
</BaseLayout>
