---
import { getCollection, render } from 'astro:content';
import AttachmentList from '@components/AttachmentList.astro';
import TagList from '@components/TagList.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { entrySlug, formatDate, visiblePost, withBase } from '@lib/site';

export async function getStaticPaths() {
  const posts = await getCollection('posts', visiblePost);
  return posts.map((post) => ({ params: { slug: entrySlug(post) }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((heading) => heading.depth <= 3);
---

<BaseLayout title={post.data.title} description={post.data.summary} socialImage={post.data.cover?.image ?? null} article>
  <article class="detail-page">
    <header class="detail-header">
      <h1>{post.data.title}</h1>
      <p class="detail-summary">{post.data.summary}</p>
      <div class="detail-byline">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        {post.data.updated && <span>更新于 {formatDate(post.data.updated)}</span>}
      </div>
    </header>
    {post.data.cover && <img class="detail-cover" src={withBase(post.data.cover.image)} alt={post.data.cover.alt} />}
    <div class="article-layout">
      {toc.length > 1 && (
        <aside class="toc" aria-label="本文目录">
          <p>目录</p>
          <ol>{toc.map((heading) => <li class={`depth-${heading.depth}`}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol>
        </aside>
      )}
      <div class="prose"><Content /></div>
    </div>
    <AttachmentList items={post.data.attachments} />
    <footer class="detail-footer">
      <p class="detail-kind">{post.data.type === 'note' ? '笔记' : '文章'}</p>
      <TagList tags={post.data.tags} />
    </footer>
  </article>
</BaseLayout>
