---
import ContentList from '@components/ContentList.astro';
import PageHeader from '@components/PageHeader.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { loadPublicCatalog } from '@lib/content';

const projects = (await loadPublicCatalog()).projects.map(({ item }) => item);
---

<BaseLayout title="项目" description="正在推进和已经完成的个人项目。">
  <PageHeader
    title="项目"
    description="把想法做成可以使用、阅读或继续讨论的东西，也保留过程中的取舍。"
  />
  <ContentList items={projects} emptyMessage="项目正在整理中。" />
</BaseLayout>
