---
import { getCollection, render } from 'astro:content';
import ContentMeta from '@components/ContentMeta.astro';
import PageTitle from '@components/PageTitle.astro';
import TagList from '@components/TagList.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { entrySlug, visibleResource, withBase } from '@lib/site';

export async function getStaticPaths() {
  const resources = (await getCollection('resources')).filter(visibleResource);
  return resources.map((resource) => ({
    params: { slug: entrySlug(resource) },
    props: { resource },
  }));
}

const { resource } = Astro.props;
const { Content } = await render(resource);
---

<BaseLayout title={resource.data.title} description={resource.data.summary}>
  <PageTitle eyebrow={resource.data.type} title={resource.data.title} description={resource.data.summary} />
  <div class="detail-grid">
    <aside>
      <ContentMeta date={resource.data.date} updated={resource.data.updated} status={resource.data.status} type={resource.data.type} />
      <TagList tags={resource.data.tags} />
      <section class="attachment-list">
        <h2>Links</h2>
        <ul>
          <li><a href={withBase(resource.data.url)}>Open resource</a></li>
          {resource.data.sourceUrl && <li><a href={resource.data.sourceUrl}>Source</a></li>}
        </ul>
      </section>
    </aside>
    <article class="prose">
      <Content />
    </article>
  </div>
</BaseLayout>
