---
import { getCollection } from 'astro:content';
import PageTitle from '@components/PageTitle.astro';
import TagList from '@components/TagList.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { byDateDesc, entrySlug, formatDate, uniqueTags, visibleResource, withBase } from '@lib/site';

const resources = (await getCollection('resources')).filter(visibleResource).sort(byDateDesc);
const tags = uniqueTags(resources);
---

<BaseLayout title="Resources" description="PDFs, videos, code, datasets, slides, images, and external links.">
  <PageTitle title="Resources" description="PDFs, videos, code, datasets, slides, images, and external links." />
  <nav class="filter-band" aria-label="Resource tags">
    {tags.map((tag) => <a class="pill" href={withBase(`/tags/${encodeURIComponent(tag)}/`)}>{tag}</a>)}
  </nav>
  <table class="resource-table">
    <thead>
      <tr>
        <th>Type</th>
        <th>Title</th>
        <th>Date</th>
        <th>Links</th>
      </tr>
    </thead>
    <tbody>
      {
        resources.map((resource) => (
          <tr>
            <td>{resource.data.type}</td>
            <td>
              <a href={withBase(`/resources/${entrySlug(resource)}/`)}>{resource.data.title}</a>
              <p class="muted">{resource.data.summary}</p>
              <TagList tags={resource.data.tags} />
            </td>
            <td><time datetime={resource.data.date.toISOString()}>{formatDate(resource.data.date)}</time></td>
            <td>
              <a href={withBase(resource.data.url)}>Open</a>
              {resource.data.sourceUrl && <><br /><a href={resource.data.sourceUrl}>Source</a></>}
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</BaseLayout>
