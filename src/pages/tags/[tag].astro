---
import ContentList from '@components/ContentList.astro';
import PageHeader from '@components/PageHeader.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { getPublicContent, uniqueTags } from '@lib/site';

export async function getStaticPaths() {
  const items = await getPublicContent();
  return uniqueTags(items).map((tag) => ({
    params: { tag },
    props: { tagName: tag, items: items.filter((item) => item.tags.includes(tag)) },
  }));
}

const { tagName, items } = Astro.props;
---

<BaseLayout title={`#${tagName}`} description={`带有 ${tagName} 标签的公开内容。`}>
  <PageHeader index="TAG" title={`#${tagName}`} description={`共有 ${items.length} 条相关内容。`} />
  <ContentList items={items} />
</BaseLayout>
