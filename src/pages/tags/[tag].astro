---
import ContentList from '@components/ContentList.astro';
import PageHeader from '@components/PageHeader.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { loadPublicCatalog } from '@lib/content';

export async function getStaticPaths() {
  const catalog = await loadPublicCatalog();
  return catalog.tags.map((tag) => ({
    params: { tag },
    props: { tagName: tag, items: catalog.items.filter((item) => item.tags.includes(tag)) },
  }));
}

const { tagName, items } = Astro.props;
---

<BaseLayout title={`#${tagName}`} description={`带有 ${tagName} 标签的公开内容。`}>
  <PageHeader title={`#${tagName}`} description="带有这个标签的公开内容。" />
  <ContentList items={items} />
</BaseLayout>
